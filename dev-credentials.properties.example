# Copy to dev-credentials.properties (gitignored) to prefill the sign-in form in DEBUG builds.
# The values are compiled into the debug APK's BuildConfig: never share a debug APK built with a real account.
# For the mock server (mocks/README.md) use SERVER_URL=http://10.0.2.2:3001 with any username and password.
SERVER_URL=http://example.com:8080
USERNAME=your-username
PASSWORD=your-password
