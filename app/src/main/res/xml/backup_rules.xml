<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: same as data_extraction_rules.xml, nothing leaves the device. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
