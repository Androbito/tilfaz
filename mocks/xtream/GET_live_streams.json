{
  "method": "GET",
  "path": "/player_api.php",
  "query": {
    "action": "get_live_streams"
  },
  "scenarios": {
    "default": {
      "status": 200,
      "bodyFile": "../fixtures/live_streams.json",
      "delayMs": 300
    },
    "empty": {
      "status": 200,
      "body": []
    },
    "server_error": {
      "status": 500,
      "body": {
        "error": "internal"
      }
    },
    "slow": {
      "status": 200,
      "bodyFile": "../fixtures/live_streams.json",
      "delayMs": 5000
    },
    "offline": {
      "dropConnection": true
    }
  }
}