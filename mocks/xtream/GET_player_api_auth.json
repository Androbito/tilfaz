  "path": "/player_api.php",
  "scenarios": {
    "default": {
      "status": 200,
      "body": {
        "user_info": {
          "username": "{{query.username}}",
          "password": "{{query.password}}",
          "message": "Welcome",
          "auth": 1,
          "status": "Active",
          "exp_date": "1804550400",
          "is_trial": "0",
          "active_cons": "0",
