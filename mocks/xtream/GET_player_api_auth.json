          "max_connections": "1",
          "allowed_output_formats": [
            "ts"
          ]
        },
        "server_info": {
          "timezone": "Europe/Paris"
        }
      }
    },
    "html_block": {
      "status": 200,
      "headers": {
        "Content-Type": "text/html"
      },
      "body": "<html><body>Blocked</body></html>"
    },
    "server_error": {
      "status": 503,
      "body": {
        "error": "maintenance"
      }
    },
    "slow": {
      "status": 200,
      "body": {
        "user_info": {
          "username": "{{query.username}}",
          "password": "{{query.password}}",
