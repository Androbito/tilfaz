# fastlane/Fastfile
# Secrets come from CI environment variables. Never commit keystores, passwords or API keys.

default_platform(:android)

platform :android do
  desc "Build signed release AAB and upload to Play internal track"
  lane :internal do
    gradle(
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"],
        "versionCode" => ENV.fetch("GITHUB_RUN_NUMBER", "1").to_i
      }
    )
    upload_to_play_store(
      track: "internal",
      json_key: ENV["PLAY_SERVICE_ACCOUNT_JSON_PATH"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote internal build to production with a staged rollout"
  lane :rollout do |options|
    fraction = (options[:fraction] || 0.01).to_f
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      rollout: fraction.to_s,
      json_key: ENV["PLAY_SERVICE_ACCOUNT_JSON_PATH"]
    )
  end
end

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true
    )
    setup_ci
    match(type: "appstore", readonly: true)   # certificates in a private git repo or storage
    increment_build_number(build_number: ENV.fetch("GITHUB_RUN_NUMBER", "1"))
    build_app(scheme: "App", export_method: "app-store")
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Submit for review with phased release"
  lane :release do
    upload_to_app_store(
      submit_for_review: true,
      automatic_release: false,
      phased_release: true,
      skip_screenshots: true,
      skip_metadata: true
    )
  end
end
